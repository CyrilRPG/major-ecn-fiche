# ──────────────────────────────────────────────────────────────
#  Major ECN Generator — Configuration
#  Copier ce fichier en `.env` puis renseigner les valeurs.
# ──────────────────────────────────────────────────────────────

# Clé API Anthropic (OBLIGATOIRE) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèles (modifiables si besoin)
MAJOR_ECN_WRITER_MODEL=claude-opus-4-5
MAJOR_ECN_VISION_MODEL=claude-sonnet-4-5

# Année universitaire affichée sur les fiches
MAJOR_ECN_YEAR=2025-2026

# Nombre de PDF traités en parallèle (4 à 8 conseillé)
MAJOR_ECN_CONCURRENCY=4

# Nombre max de caractères de cours envoyés à l'IA (contrôle des coûts)
MAJOR_ECN_MAX_INPUT_CHARS=140000

# Nombre max d'images analysées par cours (contrôle des coûts vision)
MAJOR_ECN_MAX_IMAGES=40
